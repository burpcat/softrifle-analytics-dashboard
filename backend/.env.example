# ============================================================
# HardScope Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# --- YouTube Data API v3 ---
# Required for creator discovery. Get a key at:
# https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Twitch (reserved — not used until Twitch service is added) ---
# Leave blank for now. Wired up via services/twitch.py when ready.
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# --- Kaggle CSV ---
# Path to the marketing campaigns CSV file.
# Relative to wherever you invoke seed.py or uvicorn from.
# If always running from backend/ (see Makefile), this default is correct.
KAGGLE_CSV_PATH=../data/campaigns.csv

# --- Database ---
# SQLite default — path is relative to current working directory.
# ⚠️  Always run seed.py and uvicorn from the backend/ directory (see Makefile).
#     Running from repo root creates hardscope.db there instead — two runs
#     from different directories = two separate databases, no error thrown.
# For Postgres: postgresql://user:password@localhost:5432/hardscope
DATABASE_URL=sqlite:///./hardscope.db

# --- Anthropic API ---
# Required for AI insights. Get a key at:
# https://console.anthropic.com/account/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here